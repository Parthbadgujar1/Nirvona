{
  "name": "nirvona/backend",
  "description": "Nirvona - CBT Platform Backend (PHP MVC)",
  "version": "0.1.0",
  "require": {
    "php": ">=8.2",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.7",
    "respect/validation": "^2.3",
    "firebase/php-jwt": "^6.10",
    "monolog/monolog": "^3.5",
    "predis/predis": "^2.2",
    "illuminate/database": "^11.0",
    "symfony/dotenv": "^7.0",
    "ramsey/uuid": "^4.7",
    "symfony/http-client": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11",
    "squizlabs/php_codesniffer": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "Nirvona\\": "app/",
      "Nirvona\\Database\\": "database/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse",
    "cs": "phpcs app --standard=PSR12",
    "migrate": "php artisan migrate"
  }
}
