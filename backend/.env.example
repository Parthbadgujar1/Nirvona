# Application Configuration
APP_NAME=Nirvona
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=nirvona
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSLMODE=prefer

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_CACHE_DB=1

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls

# Notification Services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment Gateway - PhonePe (https://business.phonepe.com -> Developer Settings)
# Client ID / Client Secret / Client Version come from the PhonePe Business
# dashboard. Keep PHONEPE_ENV=sandbox until you have live credentials, then
# switch to "production". Payments stay disabled while the ID/secret are blank.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Only if you configure a webhook in the PhonePe dashboard (recommended for
# production): the username/password you set there, and point the webhook at
# <backend-url>/api/payments/phonepe/callback
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_MINUTES=60
