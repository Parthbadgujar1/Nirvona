# Nirvona Frontend Configuration

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_USE_MOCK_DATA=false

# Application Environment
NODE_ENV=development

# App Configuration
NEXT_PUBLIC_APP_NAME=Nirvona
NEXT_PUBLIC_APP_VERSION=0.1.0

# Features
NEXT_PUBLIC_ENABLE_MOCK_LATENCY=true
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Session Configuration
NEXT_PUBLIC_SESSION_TIMEOUT_MS=3600000
NEXT_PUBLIC_TOKEN_STORAGE_KEY=nirvona_token

# Payment Gateway - publishable key id only. The secret key is
# server-only and belongs in backend/.env, never here (NEXT_PUBLIC_
# vars are bundled into client-shipped JS).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Frontend URL (for API CORS)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Admin Dashboard Settings
NEXT_PUBLIC_ADMIN_REFRESH_INTERVAL=30000
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=10

# Email for Support
NEXT_PUBLIC_SUPPORT_EMAIL=support@nirvona.local
NEXT_PUBLIC_SUPPORT_PHONE=+91-8800-NIRVONA
