# Nirvona Frontend Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK_DATA=false


# App Configuration
VITE_APP_NAME=Nirvona
VITE_APP_VERSION=0.1.0

# Features
VITE_ENABLE_MOCK_LATENCY=true
VITE_ANALYTICS_ENABLED=false

# Session Configuration
VITE_SESSION_TIMEOUT_MS=3600000
VITE_TOKEN_STORAGE_KEY=nirvona_token

# Frontend URL (for API CORS)
VITE_FRONTEND_URL=http://localhost:3000

# Admin Dashboard Settings
VITE_ADMIN_REFRESH_INTERVAL=30000
VITE_DEFAULT_PAGE_SIZE=10

# Email for Support
VITE_SUPPORT_EMAIL=support@nirvona.local
VITE_SUPPORT_PHONE=+91-8800-NIRVONA
